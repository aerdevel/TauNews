# Секретный ключ: сгенерируйте новый для каждого окружения.
# py -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-generated-secret-key

# Локально DEBUG=true. Для Docker/production установите DEBUG=false.
DEBUG=true
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# PostgreSQL для Docker Compose. DATABASE_URL формируется в compose.yaml.
SITE_DOMAIN=news.example.kz
POSTGRES_DB=tau_news
POSTGRES_USER=tau_news_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=false

# Для reverse proxy включать только при корректной настройке proxy.
TRUST_PROXY_SSL_HEADER=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_LOG_LEVEL=INFO
